<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="50dp"
    android:paddingEnd="22dp"
    android:paddingBottom="62dp"
    tools:context=".EditarEnemigoActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarEnemigo"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/red"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/atrasButton5"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="atras"
            android:scaleType="fitCenter"
            android:src="@drawable/atras"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/textTituloEditarEnemigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="Editar enemigo"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/editarNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Añadir nombre"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:textAlignment="center"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación:"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Descripción breve:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editarDescripcionBreve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Introduce una descripción breve"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="64dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Descripción:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editarDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Introduce una descripción"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="96dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ataque principal:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editarAtaquePrin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Introduce el ataque principal"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="64dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textView16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ataque secundario:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editarAtaqueSec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Introduce el ataque secundario"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="64dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textView18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Número de dientes:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editarDientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Introduce la cantidad de dientes"
                android:inputType="number"
                android:minHeight="48dp"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Dificultad:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <RatingBar
                android:id="@+id/editarDificultadEnemigo"
                android:progressTint="@color/red"
                android:secondaryProgressTint="@color/red"
                android:progressBackgroundTint="@color/grey_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:numStars="5"
                android:stepSize="1" />

            <Button
                android:id="@+id/bGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Guardar" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>