<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".juegos.JuegosActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarJuegosAtras"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bPiedraPapelTijera"
            android:layout_width="220dp"
            android:layout_height="70dp"
            android:layout_marginBottom="16dp"
            android:text="Piedra, papel y tijera"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bDados"
            android:layout_width="220dp"
            android:layout_height="70dp"
            android:layout_marginBottom="16dp"
            android:text="Lanzar dados"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bTresEnRaya"
            android:layout_width="220dp"
            android:layout_height="70dp"
            android:text="Tres en raya"
            android:textSize="18sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/cheshire" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="72dp"
        android:text="¿Jugamos?"
        android:textSize="24sp"
        android:textStyle="bold" />

</LinearLayout>