<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="80dp"
        android:paddingEnd="48dp"
        android:paddingBottom="80dp">

        <ImageButton
            android:id="@+id/atrasButton4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="145dp"
            android:backgroundTint="#00FFFFFF"
            android:contentDescription="atras"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/atras" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/red"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="El dispositivo ha elegido:"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/txtDispositivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:minHeight="36dp"
                    android:textAlignment="center"
                    android:textColor="@color/red"
                    android:textSize="28sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bPiedra"
                android:layout_width="200dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="Piedra"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bPapel"
                android:layout_width="200dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="Papel"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bTijera"
                android:layout_width="200dp"
                android:layout_height="64dp"
                android:text="Tijera"
                android:textSize="22sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/red"
            app:strokeWidth="2dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:stretchColumns="*">

                <TableRow>
                    <TextView
                        android:id="@+id/textView6"
                        android:layout_margin="4dp"
                        android:text="Derrotas"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_margin="4dp"
                        android:text="Victorias"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:id="@+id/txtDerrotas"
                        android:layout_margin="4dp"
                        android:text="0"
                        android:textAlignment="center"
                        android:textColor="@color/red"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/txtVictorias"
                        android:layout_margin="4dp"
                        android:text="0"
                        android:textAlignment="center"
                        android:textColor="@color/red"
                        android:textSize="24sp" />
                </TableRow>
            </TableLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</LinearLayout>