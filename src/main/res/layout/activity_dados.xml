<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".juegos.DadosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtCantidadDados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cantidad dados a tirar:" />

        <Spinner
            android:id="@+id/spinnerCantidadDados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RadioGroup
            android:id="@+id/RadioGroupTipoDado"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RadioButton
                android:id="@+id/radioButtonD6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="D6" />

            <RadioButton
                android:id="@+id/radioButtonD8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="D8" />

            <RadioButton
                android:id="@+id/radioButtonD12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="D12" />

        </RadioGroup>

        <ImageButton
            android:id="@+id/imageButtonLanzar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="333dp"
            android:text="TextView" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>