<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultado"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="34sp"
        android:padding="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:layout_marginTop="8dp">

    <TableRow>

        <Button
            android:id="@+id/bClear"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="C" />

        <Button android:id="@+id/bDivision"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="/"/>

        <Button android:id="@+id/bMultiplicacion"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="*"/>

        <Button android:id="@+id/bResta"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="-"/>

    </TableRow>

    <TableRow>

        <Button android:id="@+id/bNum7"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="7"/>

        <Button android:id="@+id/bNum8"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="8"/>

        <Button android:id="@+id/bNum9"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="9"/>

        <Button android:id="@+id/bSuma"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="+"/>

    </TableRow>

    <TableRow>

        <Button android:id="@+id/bNum4"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="4"/>

        <Button android:id="@+id/bNum5"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="5"/>

        <Button android:id="@+id/bNum6"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="6"/>

        <Button
            android:id="@+id/bIgual"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="=" />

    </TableRow>

    <TableRow>

        <Button android:id="@+id/bNum1"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="1"/>

        <Button android:id="@+id/bNum2"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="2"/>

        <Button android:id="@+id/bNum3"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text="3"/>

    </TableRow>

    <TableRow>

        <Button
            android:id="@+id/bNum0"
            android:text="0"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:layout_span="2"/>

        <Button
            android:id="@+id/bComa"
            android:layout_height="98dp"
            android:layout_margin="8dp"
            android:text=","/>

    </TableRow>

</TableLayout>

</LinearLayout>