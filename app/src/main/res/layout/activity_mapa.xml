<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".enemigos.MapaActivity">

    <TextView
        android:id="@+id/textTituloMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Mapa del País de las Maravillas"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Toca una zona del mapa para ver sus enemigos"
        android:textAlignment="center" />

    <!-- El mapa: las zonas pulsables se calculan en MapaActivity -->
    <ImageView
        android:id="@+id/imagenMapa"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Mapa del País de las Maravillas"
        android:scaleType="fitCenter"
        android:src="@drawable/mapa_wonderland" />

    <Button
        android:id="@+id/bVerTodos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="8dp"
        android:text="Ver todos los enemigos" />
</LinearLayout>
