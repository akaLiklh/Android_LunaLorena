<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/base_tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/icono_pequenno"
        android:layout_width="231dp"
        android:layout_height="146dp"
        android:layout_margin="8dp"
        android:layout_weight="1"
        app:srcCompat="@drawable/casamunecas" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tarjeta_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tarjeta_descripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripcion" />

        <TextView
            android:id="@+id/tarjeta_ataquePrin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ataque principal" />

        <TextView
            android:id="@+id/tarjeta_ataqueSec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ataque secundario" />

        <TextView
            android:id="@+id/tarjeta_numDientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Numero dientes" />

        <RatingBar
            android:id="@+id/tarjeta_dificultad"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:numStars="5" />

    </LinearLayout>
</LinearLayout>